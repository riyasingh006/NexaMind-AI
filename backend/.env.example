APP_NAME=DocuMind AI API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./data/documind.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
LOG_DIR=./logs
STORAGE_DIR=./storage
EXTRACTED_DIR=./data/extracted
PROCESSING_TEMP_DIR=./data/tmp
MAX_UPLOAD_SIZE=26214400
PROCESSING_TIMEOUT_SECONDS=120
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=100
MAX_CHUNK_SIZE=2000
CHUNKING_STRATEGY=auto
CONTENT_PREVIEW_CHARACTERS=800
CONTENT_ENDPOINT_MAX_CHARACTERS=50000
DOCUMIND_GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_GENERATION_TEMPERATURE=0.2
GEMINI_GENERATION_TIMEOUT_SECONDS=60
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH_SIZE=32
GEMINI_EMBEDDING_TIMEOUT_SECONDS=30
GEMINI_EMBEDDING_MAX_RETRIES=3
GEMINI_EMBEDDING_RETRY_BASE_SECONDS=0.5
FAISS_DIR=./storage/faiss
FAISS_BACKUP_COUNT=5
VECTOR_SEARCH_DEFAULT_TOP_K=5
VECTOR_SEARCH_MAX_TOP_K=50
VECTOR_SIMILARITY_THRESHOLD=0.0
VECTOR_INDEX_AUTO_ON_UPLOAD=true
DOCUMIND_RAG_TOP_K=8
DOCUMIND_RAG_SIMILARITY_THRESHOLD=0.35
DOCUMIND_RAG_MAX_CONTEXT_CHUNKS=10
DOCUMIND_RAG_MAX_CONTEXT_TOKENS=12000
DOCUMIND_RAG_MAX_RETRIEVAL_QUERIES=4
DOCUMIND_RAG_MULTI_QUERY_ENABLED=true
DOCUMIND_RAG_HYBRID_SEARCH_ENABLED=true
DOCUMIND_RAG_SEMANTIC_WEIGHT=0.45
DOCUMIND_RAG_LEXICAL_WEIGHT=0.30
DOCUMIND_RAG_RRF_WEIGHT=0.25
DOCUMIND_RAG_RRF_K=60
DOCUMIND_RAG_RERANKING_ENABLED=true
DOCUMIND_RAG_RERANK_TOP_K=10
DOCUMIND_RAG_FINAL_TOP_K=5
DOCUMIND_RAG_NEIGHBOR_EXPANSION_ENABLED=false
DOCUMIND_GROUNDEDNESS_ENABLED=true
DOCUMIND_GROUNDEDNESS_MAX_RETRIES=1
DOCUMIND_GROUNDEDNESS_THRESHOLD=0.75
DOCUMIND_AGENT_MAX_RETRIES=2
DOCUMIND_AGENT_TIMEOUT_SECONDS=120
